[Unit]
Description=Instap read-only research MCP server
After=network.target

[Service]
Type=simple
User=tzhu
WorkingDirectory=/var/www/instap-reports-mcp
Environment=REPORTS_CONTENT_ROOT=/var/www/reports
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=3100
ExecStart=/usr/bin/node /var/www/instap-reports-mcp/server.mjs --http
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
